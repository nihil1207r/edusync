SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Generate with: openssl rand -base64 48
SESSION_SECRET=some-long-random-string
PORT=3000

# The single origin allowed to make credentialed requests to this API.
# Defaults to http://localhost:3001 if unset — set this to your real
# frontend URL (e.g. https://app.example.com) before deploying.
FRONTEND_ORIGIN=http://localhost:3001

# Set to "production" in any live deployment. This hard-disables
# /admin/seed and /debug/profile (dev-only tools) regardless of auth, and
# enforces a minimum SESSION_SECRET length.
APP_ENV=development

# Optional — fee payments won't work without these (returns a clear error, not a fake success)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional — daily summaries and School Memory search fall back to
# rule-based logic without this. Get a free key (no credit card) at
# https://aistudio.google.com/apikey — uses gemini-2.5-flash, which is on
# Gemini's permanent free tier.
GEMINI_API_KEY=
